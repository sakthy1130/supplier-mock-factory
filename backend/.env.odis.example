# ODIS Staging (Discover Saudi tenant) — copy to .env.odis and fill in.
#
# Only the four values below are known. Everything left blank still has to be
# sourced from the ODIS platform team; a blank URL means the matching client is
# simply not usable against this env, and provisioning will fail on the first
# call that needs it.
BACKOFFICE_URL=https://enigma-portal-sandbox.discoversaudi.sa
QUICKWIT_LOGS_API_URL=https://enigma-logs-sandbox.discoversaudi.sa
TENANT_ID=6239b84f15f94102b50f4a29

# --- Still needed for ODIS ---------------------------------------------------
MOCK_SERVER_URL=
LOGS_API_URL=
MAPPING_SERVICE_URL=
CRAWLA_API_URL=
CORE_APP_URL=
BUSINESS_RULES_URL=
CONFIG_MANAGER_URL=

# Reference contracts cloned per supplier. ODIS is a separate tenant, so stg's
# ids do NOT apply — a contract cloned from another env's reference carries a
# wrong supplier_id and connectivity-core answers "Cannot find Supplier of id"
# with an empty search. Fill these from the ODIS Backoffice before provisioning.
HBS_REFERENCE_CONTRACT_ID=
EXP_REFERENCE_CONTRACT_ID=
EXT_REFERENCE_CONTRACT_ID=

# Auth — leave BACKOFFICE_TOKEN empty; auto-fetched via login on first API call
BACKOFFICE_TOKEN=

# Backoffice login (ODIS sandbox portal credentials)
BACKOFFICE_USERNAME=
BACKOFFICE_PASSWORD=
