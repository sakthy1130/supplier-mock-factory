# ODIS Staging (Discover Saudi tenant) — copy to .env.odis and fill in.
#
# Every URL below was probed live on 2026-08-26 before being recorded. Two are worth
# noting because the obvious guess is wrong:
#   CORE_APP_URL   is NOT the portal. enigma-portal-sandbox 404s /search, /packages and
#                  /booking with the Next.js portal HTML. The core is
#                  hotels-connectivity-core.odis-staging.internal — note the PLURAL
#                  "hotels", matching stg; the singular name is an nginx 404.
#   MAPPING_SERVICE_URL  ODIS has no mapping service of its own; it uses
#                  tajawal-staging's. The odis-staging name resolves but is a wildcard.
# Several *.odis-staging.internal names answer on the same internal ELB, so DNS alone
# proves nothing — probe the route before trusting a hostname.
MOCK_SERVER_URL=
CORE_APP_URL=
BUSINESS_RULES_URL=
MAPPING_SERVICE_URL=
LOGS_API_URL=
BACKOFFICE_URL=https://enigma-portal-sandbox.discoversaudi.sa
TENANT_ID=6239b84f15f94102b50f4a29


# Reference contracts are PINNED IN GIT for ODIS (seed_suppliers._BACKOFFICE_IDS),
# read off the ODIS Backoffice, so nothing is needed here. Set one of these only to
# override the pinned value for a local experiment.
#HBS_REFERENCE_CONTRACT_ID=
#EXP_REFERENCE_CONTRACT_ID=
#EXT_REFERENCE_CONTRACT_ID=

# Auth — leave BACKOFFICE_TOKEN empty; auto-fetched via login on first API call
BACKOFFICE_TOKEN=

# Backoffice login (ODIS sandbox portal credentials)
BACKOFFICE_USERNAME=
BACKOFFICE_PASSWORD=

# Deliberately EMPTY on ODIS — do not go hunting for these:
#   CONFIG_MANAGER_URL   read NOWHERE in the codebase. ConfigManagerClient clears the
#                        apiKey cache against backoffice_url, not this host, so every
#                        env leaves it blank. (The cache clear DOES run on every apiKey,
#                        not only SmartBooking ones.)
#   CRAWLA_API_URL       ODIS has no Crawla.
#   QUICKWIT_LOGS_API_URL  ODIS has no Quickwit; LOGS_API_URL is the log surface.
CONFIG_MANAGER_URL=
CRAWLA_API_URL=
QUICKWIT_LOGS_API_URL=
