# Values common to every environment (dev + stg). Copy to .env.shared and fill in.
# Env-specific overrides live in .env.dev / .env.stg and win over these.

MAPPING_API_KEY=
CRAWLA_API_KEY=

# Reference contracts for cloning (leave blank to use the minimal-body fallback)
HBS_REFERENCE_CONTRACT_ID=
EXP_REFERENCE_CONTRACT_ID=
RHK_REFERENCE_CONTRACT_ID=
CHC_REFERENCE_CONTRACT_ID=
API_KEY_TEMPLATE_UID=

# App (single shared SQLite DB — scenarios are tagged with their env, not split by DB)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
LOG_LEVEL=INFO
# MongoDB persistence. MONGO_URL carries credentials, so keep the real value in
# the git-ignored .env / .env.shared / .env.<env> files only.
MONGO_URL=mongodb://<user>:<password>@127.0.0.1:27017/<db>?authSource=<db>
MONGO_DB_NAME=appdb
