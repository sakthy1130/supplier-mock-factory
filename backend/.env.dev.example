# Dev Enigma / connectivity URLs — copy to .env.dev and fill in secrets.
MOCK_SERVER_URL=http://mockserver-dev.tajawal.io
LOGS_API_URL=https://enigma-logs-dev.almosafer.com/
QUICKWIT_LOGS_API_URL=http://quickwit-nonprod.tajawal-prod-devops.internal/api/v1
MAPPING_SERVICE_URL=http://hotels-integration-mapping-service.tajawal-dev.internal
CRAWLA_API_URL=http://alm-crawla-realtime-api-dev.alm-data.io
CORE_APP_URL=http://hotels-connectivity-core.tajawal-dev.internal
BUSINESS_RULES_URL=http://hotel-connectivity-br.tajawal-dev.internal
BACKOFFICE_URL=http://enigma-portal-dev.almosafer.com
CONFIG_MANAGER_URL=http://hotels-connectivity-config.tajawal-dev.internal/

# Reference contracts cloned per supplier on dev (real supplier ids/fields the
# adapters need). Without a reference id the provisioner falls back to a minimal
# synthesized body with a wrong supplier_id -> connectivity-core "Cannot find
# Supplier of id" and empty search (this is the EXT contract bug). Keep these set.
# (HBS/EXP/RHK/CHC also come from .env.shared / legacy .env.)
EXT_REFERENCE_CONTRACT_ID=64abf676042ebe591367e3dd

# Auth — leave BACKOFFICE_TOKEN empty; auto-fetched via login on first API call
BACKOFFICE_TOKEN=
TENANT_ID=

# Backoffice login (dev portal credentials)
BACKOFFICE_USERNAME=
BACKOFFICE_PASSWORD=
