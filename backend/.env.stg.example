# Staging Enigma / connectivity URLs — copy to .env.stg and fill in secrets.
MOCK_SERVER_URL=http://mockserver-staging.tajawal.io
LOGS_API_URL=https://enigma-logs-staging.almosafer.com/
QUICKWIT_LOGS_API_URL=http://quickwit-nonprod.tajawal-prod-devops.internal/api/v1
MAPPING_SERVICE_URL=http://hotels-integration-mapping-service.tajawal-staging.internal
CRAWLA_API_URL=http://alm-crawla-realtime-api-stage.alm-data.io
CORE_APP_URL=http://hotels-connectivity-core.tajawal-staging.internal
BUSINESS_RULES_URL=http://hotel-connectivity-br.tajawal-staging.internal
BACKOFFICE_URL=http://enigma-portal-staging.almosafer.com
CONFIG_MANAGER_URL=http://hotels-connectivity-config.tajawal-staging.internal/

# Reference contracts cloned per supplier on stg (real supplier ids/fields the
# adapters need). Without a reference id the provisioner falls back to a minimal
# synthesized body with a wrong supplier_id -> connectivity-core "Cannot find
# Supplier of id" and empty search (this is the EXT contract bug). Keep these set.
# (HBS/EXP/RHK/CHC also come from .env.shared / legacy .env.)
EXT_REFERENCE_CONTRACT_ID=677e5cb9b69d967192423949

# Auth — leave BACKOFFICE_TOKEN empty; auto-fetched via login on first API call
BACKOFFICE_TOKEN=
TENANT_ID=

# Backoffice login (staging portal credentials)
BACKOFFICE_USERNAME=
BACKOFFICE_PASSWORD=
